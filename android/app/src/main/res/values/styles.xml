<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Launchpad" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:statusBarColor">@color/brand</item>
    <item name="android:navigationBarColor">@color/brand</item>
    <item name="android:windowBackground">@color/brand</item>
  </style>
  <style name="Launchpad.Game">
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowBackground">@color/night</item>
    <item name="android:statusBarColor">@color/night</item>
    <item name="android:navigationBarColor">@color/night</item>
  </style>
</resources>
